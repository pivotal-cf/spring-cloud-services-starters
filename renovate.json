{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranches": ["main", "4.3.x"],
  "rebaseWhen": "behind-base-branch",
  "enabledManagers": ["gradle", "gradle-wrapper"],
  "extends": ["config:recommended"],
  "ignorePaths": ["**/gradle.properties"],
  "packageRules": [
    {
      "labels": ["dependencies", "gradle"],
      "matchFileNames": ["gradle/**/*"]
    },
    {
      "labels": ["dependencies", "java"],
      "matchFileNames": ["**/*.gradle", "**/gradle.*"]
    },
    {
      "matchPackageNames": ["org.springframework.cloud:spring-cloud-dependencies"],
      "allowedVersions": "< 2025.1.0",
      "matchBaseBranches": ["4.3.x"]
    }
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0
}
